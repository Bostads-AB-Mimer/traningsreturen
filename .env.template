# Träningsreturen — environment template. Copy to .env and adjust.

# --- Database (SQL Server) ---
# SA password for the compose-managed instance / login for an existing one.
DB_PASSWORD=Str0ng!Passw0rd
DB_NAME=traningsreturen
# Used when running the backend outside Docker:
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa

# --- Auth ---
# 'oidc' (Keycloak, production) or 'demo' (role switcher, demo environments only)
AUTH_MODE=oidc
# Client id — also where app roles are read from (resource_access.<id>.roles)
OIDC_CLIENT_ID=traningsreturen-app

# Pick ONE Keycloak. All four values in a block belong together: the backend
# validates tokens (issuer + JWKS) from the same Keycloak the frontend logs in
# against (URL + realm, baked in at build — rebuild with --build after switching).

# A) Compose-managed local Keycloak (demo accounts, works out of the box):
OIDC_ISSUER=http://localhost:8080/realms/traningsreturen
OIDC_JWKS_URI=http://keycloak:8080/realms/traningsreturen/protocol/openid-connect/certs
PUBLIC_KEYCLOAK_URL=http://localhost:8080
PUBLIC_KEYCLOAK_REALM=traningsreturen
AUTO_PROVISION_USERS=false

# B) Mimer's shared dev Keycloak (AD federated). The client must allow
#    redirect http://localhost:8081/* and web origin http://localhost:8081.
#OIDC_ISSUER=https://auth.dev.mimer.nu/realms/onecore
#OIDC_JWKS_URI=https://auth.dev.mimer.nu/realms/onecore/protocol/openid-connect/certs
#PUBLIC_KEYCLOAK_URL=https://auth.dev.mimer.nu
#PUBLIC_KEYCLOAK_REALM=onecore
## Create app users automatically on first AD login
#AUTO_PROVISION_USERS=true

# Keycloak bootstrap admin (local compose Keycloak only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Rules engine ---
# Expiry concept (KONCEPT): earned time expires after 12 months, FIFO on
# withdrawal, expiry rows + "expires within 3 months" notice.
FEATURE_EXPIRY=false
#RULES_RETURN_SHARE_PERCENT=20
#RULES_WEEKLY_CAP_MINUTES=36
#RULES_MAX_BACKDATE_DAYS=60
#RULES_EXPIRY_MONTHS=12
#RULES_EXPIRY_WARNING_MONTHS=3

# --- Demo data ---
# Seed Swedish demo data on backend startup (demo environments only).
SEED_DEMO_DATA=false

# --- Misc ---
PORT=4000
# Origin of the frontend (compose and pnpm dev both serve it on :8081)
CORS_ORIGIN=http://localhost:8081
LOG_LEVEL=info
