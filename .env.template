# Träningsreturen — environment template. Copy to .env and adjust.

# --- Database (SQL Server) ---
# SA password for the compose-managed instance / login for an existing one.
DB_PASSWORD=Str0ng!Passw0rd
DB_NAME=traningsreturen
# Used when running the backend outside Docker:
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa

# --- Auth ---
# 'oidc' (Keycloak, production) or 'demo' (role switcher, demo environments only)
AUTH_MODE=oidc
# Mimer's shared dev Keycloak (AD federated):
OIDC_ISSUER=https://auth.dev.mimer.nu/realms/onecore
# Compose-managed local Keycloak alternative:
#OIDC_ISSUER=http://localhost:8080/realms/traningsreturen
# Client id — also where app roles are read from (resource_access.<id>.roles)
OIDC_CLIENT_ID=traningsreturen-app
# Create app users automatically on first AD login (manager set by admin later)
AUTO_PROVISION_USERS=true
# Defaults to <issuer>/protocol/openid-connect/certs
#OIDC_JWKS_URI=
# Keycloak bootstrap admin (compose only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# URL browsers use to reach Keycloak (frontend build arg)
PUBLIC_KEYCLOAK_URL=http://localhost:8080

# --- Rules engine ---
# Expiry concept (KONCEPT): earned time expires after 12 months, FIFO on
# withdrawal, expiry rows + "expires within 3 months" notice.
FEATURE_EXPIRY=false
#RULES_RETURN_SHARE_PERCENT=20
#RULES_WEEKLY_CAP_MINUTES=36
#RULES_MAX_BACKDATE_DAYS=60
#RULES_EXPIRY_MONTHS=12
#RULES_EXPIRY_WARNING_MONTHS=3

# --- Demo data ---
# Seed Swedish demo data on backend startup (demo environments only).
SEED_DEMO_DATA=false

# --- Misc ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
