# Backend local development — copy to backend/.env
PORT=4000
# 'demo' enables the role switcher personas (no Keycloak needed)
AUTH_MODE=demo
# Mimer's shared dev Keycloak (AD federated) — use with AUTH_MODE=oidc:
OIDC_ISSUER=https://auth.dev.mimer.nu/realms/onecore
OIDC_CLIENT_ID=traningsreturen-app
# Create app users automatically on first AD login (manager set by admin later)
AUTO_PROVISION_USERS=true
# Compose-managed local Keycloak alternative:
#OIDC_ISSUER=http://localhost:8080/realms/traningsreturen
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=Str0ng!Passw0rd
DB_NAME=traningsreturen
FEATURE_EXPIRY=true
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
